{
  "name": "@tabtab/admin",
  "version": "0.0.1",
  "private": true,
  "description": "ApiPig Gateway App",
  "type": "module",
  "scripts": {
    "dev": "node internal/dev-cli/index.mjs",
    "build:packages": "pnpm --filter @tabtab/utils build && pnpm --filter @tabtab/ui build",
    "build": "pnpm build:packages && vp build --mode prod",
    "test": "vp test",
    "test:run": "vp test run",
    "check": "vp check",
    "lint": "vp lint",
    "clean": "node internal/dev-cli/index.mjs --clean",
    "clean:all": "node internal/dev-cli/index.mjs --clean --all",
    "clean:deep": "node internal/dev-cli/index.mjs --clean --deep",
    "fmt": "vp fmt",
    "stub": "pnpm -r --filter './packages/*' --filter './internal/*' run stub"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "@lucide/vue": "catalog:",
    "@tabtab/styles": "workspace:*",
    "@tabtab/ui": "workspace:*",
    "@tabtab/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "node-forge": "^1.4.0",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "3.5.40",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@tabtab/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/node-forge": "^1.3.14",
    "@vitejs/plugin-vue": "catalog:",
    "@voidzero-dev/vite-plus-core": "0.1.13",
    "@voidzero-dev/vite-plus-test": "0.1.13",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "0.1.13",
    "vue-sfc-transformer": "catalog:",
    "vue-tsc": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.13",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.13"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1"
}
